<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-x64</RuntimeIdentifier>
    <ApplicationId>org.z0mb1es.photochecks</ApplicationId>
    <ApplicationTitle>Creator photo checks</ApplicationTitle>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AppSettingsDirectory>$(MSBuildThisFileDirectory)../../out/android/photo-checks</AppSettingsDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Port.AndroidGame/PhotoPicker.cs" Link="PhotoPicker.cs" />
    <Reference Include="Port.Hooks"><HintPath>../../src/Port.AndroidHooks/bin/Release/net10.0/Port.Hooks.dll</HintPath></Reference>
  </ItemGroup>
</Project>
